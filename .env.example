DISABLE_HMR=

# Turso (libSQL / SQLite Cloud)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token

# GitHub Repository Image Storage (Thay thế Supabase Storage)
GITHUB_TOKEN=ghp_yourPersonalAccessToken
GITHUB_OWNER=your-github-username
GITHUB_REPO=exam-images
GITHUB_BRANCH=main
VITE_GITHUB_TOKEN=ghp_yourPersonalAccessToken
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=exam-images
VITE_GITHUB_BRANCH=main
